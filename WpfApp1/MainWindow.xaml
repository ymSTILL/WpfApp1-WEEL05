<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WPF 飲料訂購與動態選單系統" Height="550" Width="820" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 功能操作按鈕區 -->
            <RowDefinition Height="Auto"/>
            <!-- 用餐方式區 -->
            <RowDefinition Height="*"/>
            <!-- 動態菜單區 -->
            <RowDefinition Height="Auto"/>
            <!-- 計算與結果顯示區 -->
        </Grid.RowDefinitions>

        <!-- 1. 功能操作區 -->
        <Border Grid.Row="0" Background="#F3F4F6" Padding="10" CornerRadius="5" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="btnLoadCsv" Content="📂 載入 CSV 菜單 (OpenFileDialog)" Padding="10,6" Click="btnLoadCsv_Click" Margin="0,0,10,0"/>
                <Button x:Name="btnExportOrder" Content="💾 匯出訂單明細 (SaveFileDialog)" Padding="10,6" Click="btnExportOrder_Click"/>
            </StackPanel>
        </Border>

        <!-- 2. 用餐方式選擇區 -->
        <GroupBox Grid.Row="1" Header="用餐方式" Margin="0,0,0,10" Padding="5">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="rbInStore" Content="內用" IsChecked="True" FontSize="14" Margin="20,0,30,0" Checked="RadioButton_Checked"/>
                <RadioButton x:Name="rbTakeOut" Content="外帶" FontSize="14" Checked="RadioButton_Checked"/>
            </StackPanel>
        </GroupBox>

        <!-- 3. 動態 UI 放置容器 -->
        <GroupBox Grid.Row="2" Header="飲料菜單區 (動態 UI 生成容器)" Padding="5">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="DrinkMenuStackPanel" Background="#FAF9F6"/>
            </ScrollViewer>
        </GroupBox>

        <!-- 4. 計算與結果顯示區 -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="tbResult" Grid.Column="0" Text="【提示】請先載入 CSV 菜單，並勾選品項與調整數量。" 
                       Background="#EFF6FF" Padding="10" FontSize="14" LineHeight="22" TextWrapping="Wrap" MinHeight="100"/>

            <Button x:Name="btnCalculate" Grid.Column="1" Content="🧮 計算總金額&#10;(樹狀走訪)" 
                    Width="160" Margin="10,0,0,0" Background="#0284C7" Foreground="White" 
                    FontWeight="Bold" FontSize="15" Click="btnCalculate_Click"/>
        </Grid>
    </Grid>
</Window>